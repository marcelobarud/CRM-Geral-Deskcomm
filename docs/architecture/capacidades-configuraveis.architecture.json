    {
      "id": "ui",
      "lane": "humano",
      "col": 4,
      "type": "ui",
      "label": "Read model único: navegação, composer e histórico autorizado"
    },
    {
      "id": "audit",
      "lane": "db",
      "col": 6,
      "type": "service",
      "label": "api_audit_log: capability.config_changed"
    },
    {
      "id": "revisao",
      "lane": "humano",
      "col": 7,
      "type": "ui",
      "label": "Admin audit e correção de habilitação"
    }
  ],
  "edges": [
    { "from": "config", "to": "rpc", "label": "escolha humana sem org no body" },
    { "from": "rpc", "to": "settings", "label": "lock, merge de namespace e revisão" },
    { "from": "settings", "to": "guard", "label": "leitura sem cache e filtro de organização" },
    { "from": "registry", "to": "guard", "label": "suporte e default da release" },
    { "from": "guard", "to": "portas", "label": "execute bloqueado se não efetivo" },
    { "from": "settings", "to": "rls", "label": "fn_capability_enabled" },
    { "from": "portas", "to": "rls", "label": "organização, papel e autoria continuam aplicados" },
    { "from": "guard", "to": "ui", "label": "GET capabilities sem secrets" },
    { "from": "ui", "to": "portas", "label": "uso ou history explícito; backend revalida" },
    { "from": "ui", "to": "config", "label": "estado e motivo orientam próximo passo" },
    { "from": "rpc", "to": "audit", "label": "ator, organização, antes/depois e revisão" },
    { "from": "audit", "to": "revisao", "label": "filtro derivado de AUDIT_ACTIONS" },
    { "from": "revisao", "to": "config", "label": "correção pelo mecanismo canônico" }
  ]
