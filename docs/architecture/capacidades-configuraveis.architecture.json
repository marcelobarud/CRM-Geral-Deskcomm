{
  "schema_version": 1,
  "diagram_type": "architecture",
  "meta": {
    "title": "Capacidades configuráveis do CRM Geral",
    "subtitle": "Suporte, habilitação, autorização e prontidão independentes",
    "output": "capacidades-configuraveis.html",
    "quality_profile": "standard"
  },
  "lanes": [
    { "id": "app", "label": "Aplicativo" },
    { "id": "db", "label": "Banco" },
