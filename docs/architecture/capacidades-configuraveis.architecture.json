  "mainPath": ["config", "rpc", "settings", "guard", "portas", "audit"],
  "nodes": [
    {
      "id": "config",
      "lane": "humano",
      "col": 1,
      "type": "ui",
      "label": "Configurações › Módulos e capacidades"
    },
    {
      "id": "rpc",
      "lane": "app",
      "col": 2,
      "type": "service",
      "label": "PATCH admin + MFA/suporte; fn_set_capability atômica"
    },
    {
      "id": "settings",
      "lane": "db",
      "col": 3,
      "type": "service",
      "label": "organizations.settings.capabilities; namespace protegido"
    },
    {
      "id": "registry",
      "lane": "app",
      "col": 1,
      "type": "service",
      "label": "Registry da release: respostas rápidas, default ligado"
    },
    {
      "id": "guard",
      "lane": "app",
      "col": 4,
      "type": "service",
      "label": "Resolver + requireRole + guard fresco antes de efeito"
    },
    {
      "id": "portas",
      "lane": "app",
      "col": 5,
      "type": "service",
      "label": "REST message-templates e tools MCP list/render"
    },
    {
      "id": "rls",
      "lane": "db",
      "col": 5,
      "type": "service",
      "label": "RLS original + flag restritiva em INSERT/UPDATE/DELETE"
